# ---- Flask backend ----
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# "supabase" (real) or "memory" (local demo / tests, no persistence)
DATA_BACKEND=supabase

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used ONLY for admin endpoints after the caller is verified as admin. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_BUCKET=evidence

# ---- Optional: SMS alerts via Twilio (NOT active unless all three are set) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
